# Firebase Web config is public, not a service-account credential.
# For live-service local development, copy these to ignored app/.dev.vars,
# fill them from Firebase > Project settings > Your apps, then use npm run dev.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# Never set AUTH_EMULATOR in production. npm run dev:local configures it locally.
